{
    "consentStatement": "Deepfake Detective is a university course project investigating how people recognize AI-generated political videos. Participation involves watching videos, answering questions, and completing a short educational activity. Participation is voluntary, and responses will be used for the course project.",
    "questions": [
        {
            "id": "age",
            "label": "Age",
            "type": "number",
            "required": true,
            "min": 15,
            "max": 100
        },
        {
            "id": "gender",
            "label": "Gender",
            "type": "radio",
            "required": true,
            "options": [
                "Woman",
                "Man",
                "Non-binary",
                "Prefer not to say"
            ]
        },
        {
            "id": "education_level",
            "label": "Highest education level",
            "type": "select",
            "required": true,
            "options": [
                "Compulsory education",
                "Upper secondary education",
                "Vocational education and training",
                "Bachelor's degree",
                "Master's degree",
                "Doctoral degree",
                "Prefer not to say"
            ]
        },
        {
            "id": "ai_content_familiarity",
            "label": "Familiarity with AI-generated content",
            "type": "radio",
            "required": true,
            "options": [
                "Not at all familiar",
                "Slightly familiar",
                "Moderately familiar",
                "Very familiar",
                "Extremely familiar"
            ]
        },
        {
            "id": "deepfake_experience",
            "label": "Previous experience with deepfakes",
            "type": "radio",
            "required": true,
            "options": [
                "No experience",
                "Limited experience",
                "Moderate experience",
                "Extensive experience"
            ]
        }
    ]
}
